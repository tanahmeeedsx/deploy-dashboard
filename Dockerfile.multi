# Multi-stage Dockerfile
#
# Stage 1 (builder): Node.js compiles the React app into static files.
# Stage 2 (runner):  Nginx serves ONLY those files.
#                    Node.js, npm, devDependencies and source code are discarded.

# ---------- Stage 1: build ----------
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

ENV VITE_BUILD_TYPE="Multi-stage Build"

RUN npm run build

# ---------- Stage 2: serve ----------
FROM nginx:alpine AS runner

# Copy only the compiled output from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Nginx listens on port 80 inside the container
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
